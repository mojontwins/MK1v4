ROOMS = 20
ALIAS %DISKETTES = 1

# TODO : SOME TEXT

ENTERING GAME
	IF TRUE
	THEN
		%DISKETTES = 0
		OBJS = 0
	END
END

ENTERING ANY
	IF TRUE
	THEN
		%TALK_FLAG = 0
	END
END

# Enemy interaction test

ENEMY TOUCHED
	IF EN_T = 3
	IF %TALK_FLAG = 0
	THEN
		TEXT "NO SE COMO SE ASE AIUDA"
		SOUND 2
		%TALK_FLAG = 1
	END
END 

# Hub screen
# Entering the hub screen we must draw the mainframe.
# Pressing ACTION in the hub screen we must trigger the
# "enter disk" logics.

ENTERING SCREEN 2, 7, 12, 17 
	IF TRUE
	THEN
		SET TILE (7, 7) = 17
		SET TILE (7, 8) = 18
	END
END

PRESS_FIRE AT SCREEN 2, 7, 12, 17
	IF OBJS = 1
	IF PLAYER AT (7, 8)
	THEN
		INC %DISKETTES, 1
		OBJS = 0
		SOUND 7
	END
END

# Office screen
# Entering the office screen we must check if
# game ending conditions have been fullfilled:

ENTERING SCREEN 15
	IF KILLED = 25
	IF %DISKETTES = 15
	THEN
		WIN GAME
	END IF

END
