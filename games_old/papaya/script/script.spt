# Script papayas!

# Main shit
ROOMS = 40

# For text boxes
TEXT WIDTH = 22

# Explicitly set %CARRYING to FLAG 0 (as defined in ITEM_FLAG @ config.h)
# Explicitly set %TOTAL_PAPAYAS to FLAG 1
ALIAS %CARRYING = 0
ALIAS %TOTAL_PAPAYAS = 31

# The box
# =======

# This game adds a box to the gameplay. The box is initialised
# for each "level" in the screen it first appears if %NEWLEVEL = 1.
# %BOXP, %BOXX, %BOXY, %BOXT control the location and the tile it overwrites.
# On entering any the box must be set if %NEWLEVEL = 0.

# Well use %BOXP = 99 to signify we have the box.

# Note that ENTERING ANY is run before ENTERING SCREEN X, so this works.

ENTERING GAME
	IF TRUE
	THEN
		# Reset total & show
		%TOTAL_PAPAYAS = 0
		EXTERN 3

		# Init map: (re-)place papayas.
		EXTERN 0

		# New game = new level
		%NEWLEVEL = 1

		# Info texts / etc
		%FLAG_PAPAI = 0
		%FLAG_VIEJO = 0
	END

END

# Script subroutines

SUB PLACEBOX
	# Make sure the box is placed using the right tile
	IF TRUE
	THEN
		%BOXT = TILE AT (%BOXX, %BOXY)
		%AUX = 33
	END

	IF %BOXT > 0
	IF %BOXT < 7
	THEN
		%AUX = %BOXT
		INC %AUX, 33		
	END

	IF TRUE
	THEN		
		SET TILE (%BOXX, %BOXY) = %AUX
	END 
END

SUB VIEJO
	IF %FLAG_VIEJO = 0
	THEN
		%FLAG_VIEJO = 1
		TEXT BOX "EU VENDO MAM*ES, MAS O ESTO QUE ACABOU. SEI ONDE VOCE PODE /ENCON- TRAR/ ALGUNS. TRAGA ALGUNA PAR MIM, VOCE FICA COM UNA PARTE PARA A CRIAN+A E DIVI- DIMOS O RESTO!"
		BREAK
	END

	IF OBJS > 0
	THEN
		INC %TOTAL_PAPAYAS, OBJS
		OBJS = 0
		SOUND 8
		EXTERN 3 					# Update HUD
	END
END

# For every screen

ENTERING ANY
	# Let's clear the papayas
	IF TRUE
	THEN
		EXTERN 2
	END

	# Reset Carrying
	IF %NEWLEVEL = 1
	THEN
		%CARRYING = 47
	END

	# Let's place the box.
	IF %NEWLEVEL = 0
	IF NPANT = %BOXP
	THEN
		CALL PLACEBOX
	END
END

# Per screen. Place box, etc.

ENTERING SCREEN 1
	IF %NEWLEVEL = 1
	THEN
		%BOXP = 1
		%BOXX = 13
		%BOXY = 4
		%NEWLEVEL = 0
		CALL PLACEBOX
	END 
END

# Place box

PRESS_FIRE AT ANY
	# We don't have expressions so...
	IF TRUE
	THEN
		%AUX = TY
		INC %AUX,1
		%TAUX = TILE AT (TX, %AUX)
	END

	# Get the box
	IF %BOX9 <> 99 					# Not really needed but makes debugging easier.
	IF %TAUX > 32
	IF %TAUX < 41
	THEN
		%BOXP = 99
		SET TILE (TX, %AUX) = %BOXT
		SOUND 1
		%CARRYING = 33
		BREAK
	END

	# Place the box
	IF %BOXP = 99
	IF BEH AT (TX, %AUX) <> 0
	IF TY > 0
	THEN
		%BOXP = NPANT
		%BOXX = TX
		%BOXY = TY
		DEC PY, 20
		SOUND 1
		CALL PLACEBOX
		%CARRYING = 47
	END

END IF

# Special BG interaction

SPECIAL TILE TOUCHED

	# The barro!

	IF TN = 19
	IF OBJS > 0
	THEN
		OBJS = 0
		SOUND 2
		BREAK
	END

	# The papayas!

	IF TN = 16
	IF OBJS < 16
	THEN
		SET TILE(TX, TY) = 12
		INC OBJS, 1
		SOUND 7
		EXTERN 1 					# Persist!
		BREAK
	END
END

# Special character interaction

ENEMY TOUCHED

	# The vieho!
	IF EN_T = 1	
	THEN
		CALL VIEJO
	END

END
