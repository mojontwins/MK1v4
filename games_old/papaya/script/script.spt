# Script papayas!

# Main shit
ROOMS = 40

# For text boxes
TEXT WIDTH = 22

# Explicitly set %CARRYING to FLAG 0 (as defined in ITEM_FLAG @ config.h)
ALIAS %CARRYING = 0

# Explicitly set %TOTAL_PAPAYAS to FLAG 1
ALIAS %TOTAL_PAPAYAS = 1

# Explicitly set %SIGNAL_TEXTBOX to FLAG 2 
# (won't clear screen after textbox if set)
# (must be reset explicitly in the engine!)
ALIAS %SIGNAL_TEXTBOX = 2

# Use this flag to reset the player to the first
# screen in the level when caught by the guard
ALIAS %FIRST_SCREEN = 3

# The box
# =======

# This game adds a box to the gameplay. The box is initialised
# for each "level" in the screen it first appears if %NEW_LEVEL = 1.
# %BOXP, %BOXX, %BOXY, %BOXT control the location and the tile it overwrites.
# On entering any the box must be set if %NEW_LEVEL = 0.

# Well use %BOXP = 99 to signify we have the box.

# Note that ENTERING ANY is run before ENTERING SCREEN X, so this works.

ENTERING GAME
	IF TRUE
	THEN
		# Reset total & show
		%TOTAL_PAPAYAS = 0
		EXTERN 3

		# Init map: (re-)place papayas.
		EXTERN 0

		# New game = new level
		%NEW_LEVEL = 1

		# Info texts / etc
		%FLAG_PAPAI = 0
		%FLAG_VIEJO = 1  #########DEBUG!
		%FLAG_MAMOES = 0
		%FLAG_LEAVE = 0
		%FLAG_BARRO = 0

		# Where to return if caught
		# Player will be reset to 2,2 so
		# make sure this makes sense when
		# designing the map!
		# Also don't forget to reset this when
		# going to the next level!
		%FIRST_SCREEN = 0
	END

END

# Script subroutines

SUB PLACEBOX
	# Make sure the box is placed using the right tile
	IF TRUE
	THEN
		%BOXT = TILE AT (%BOXX, %BOXY)
		%AUX = 33
	END

	IF %BOXT > 0
	IF %BOXT < 7
	THEN
		%AUX = %BOXT
		INC %AUX, 33		
	END

	IF TRUE
	THEN		
		SET TILE (%BOXX, %BOXY) = %AUX
	END 
END

SUB ADVERTENCIAS
	# Level 1 is general introduction
	IF %FIRST_SCREEN = 0
	THEN
		TEXT BOX "VIEJO: SIM, EU VENDO MAM*ES... MAS O ESTO QUE ACABOU. SEI ONDE VOCE PODE /ENCONTRAR/ ALGUNS."
		TEXT BOX "VIEJO: VOCE VAI LA, PEGA OS MAM*ES, GUARDA ALGUNS PARA LA CRIAN+A, E DIVIDIMOS O RESTO MEIO A MEIO!"
	END

	# In level 2 he warns you about the guard!
	IF %FIRST_SCREEN = 8
	THEN
		TEXT BOX ""
	END
END

SUB VIEJO
	IF %FLAG_VIEJO = 0
	THEN
		%FLAG_VIEJO = 1
		CALL ADVERTENCIAS
		%FLAG_LEAVE = 1
		BREAK
	END

	IF %FLAG_LEAVE = 0
	THEN
		INC %TOTAL_PAPAYAS, OBJS
		OBJS = 0
		SOUND 8
		EXTERN 3 					# Update HUD
		%SIGNAL_TEXTBOX = 1 		# This will make our text box not clear the screen
		TEXT BOX "VIEJO: MAIS MAM*ES OU DEVERIAMOS PROCURAR OUTRO LUGAR?"
		%DIALOG_RES = DIALOG "MAS PAPAYAS", "OTRO LUGAR"
		%FLAG_LEAVE = 1
	END
END

SUB BARRO
	IF %FLAG_BARRO = 0
	THEN
		%FLAG_BARRO = 1
		TEXT BOX "AL CAER AL BARRO PURULENTO SE HAN ESTROPEADO TODAS LAS PAPAYAS! ESTAS YA NO SIRVEN!"
	END
END

SUB MAMOES
	IF OBJS = 16
	IF %FLAG_MAMOES = 0
	THEN 
		TEXT BOX "YA NO PUEDO ACARREAR MAS PAPAYAS. MEJOR SE LAS DEJO AL VIEJO Y VUELVO A POR MAS..."
		%FLAG_MAMOES = 1
		BREAK
	END

	IF OBJS < 16
	THEN
		SET TILE(TX, TY) = 12
		INC OBJS, 1
		SOUND 7
		EXTERN 1 					# Persist!
		BREAK
	END
END

SUB NEXT_LEVEL_DO
	IF %FIRST_SCREEN = 0
	THEN
		%JUMP_TO = 8
		BREAK
	END
END

# For every screen

ENTERING ANY
	# Let's clear the papayas
	IF TRUE
	THEN
		EXTERN 2

		# Just entered, may leave if talking to viejo
		%FLAG_LEAVE = 0
	END

	# Reset Carrying
	IF %NEW_LEVEL = 1
	THEN
		%CARRYING = 47
	END

	# Let's place the box.
	IF %NEW_LEVEL = 0
	IF NPANT = %BOXP
	THEN
		CALL PLACEBOX
	END
END

# Per screen. Place box, etc.

# First level starts in screen 0, but
# box is placed in screen 1...

ENTERING SCREEN 1
	IF %NEW_LEVEL = 1
	THEN
		%BOXP = 1
		%BOXX = 13
		%BOXY = 4
		%NEW_LEVEL = 0
		CALL PLACEBOX
	END 
END

# Second level starts in screen 8, it also
# contains the box.

ENTERING SCREEN 8
	IF %NEW_LEVEL = 1
	THEN
		%FIRST_SCREEN = 8
		%BOXP = 8
		%BOXX = 2
		%BOXY = 8
		%NEW_LEVEL = 0
		CALL PLACEBOX
	END
END

# Place box

PRESS_FIRE AT ANY
	# We don't have expressions so...
	IF TRUE
	THEN
		%AUX = TY
		INC %AUX,1
		%TAUX = TILE AT (TX, %AUX)
	END

	# Get the box
	IF %BOX9 <> 99 					# Not really needed but makes debugging easier.
	IF %TAUX > 32
	IF %TAUX < 41
	THEN
		%BOXP = 99
		SET TILE (TX, %AUX) = %BOXT
		SOUND 1
		%CARRYING = 33
		BREAK
	END

	# Place the box
	IF %BOXP = 99
	IF BEH AT (TX, %AUX) <> 0
	IF TY > 0
	THEN
		%BOXP = NPANT
		%BOXX = TX
		%BOXY = TY
		DEC PY, 20
		SOUND 1
		CALL PLACEBOX
		%CARRYING = 47
	END

END IF

# Special BG interaction

SPECIAL TILE TOUCHED

	# The barro!

	IF TN = 19
	IF OBJS > 0
	THEN
		CALL BARRO
		OBJS = 0
		SOUND 2
		BREAK
	END

	# The papayas!

	IF TN = 16
	THEN
		CALL MAMOES
		BREAK
	END

END

# Special character interaction

ENEMY TOUCHED
	IF TRUE 
	THEN
		%DIALOG_RES = 0
		%JUMP_TO = 0
	END

	# The vieho!
	IF EN_T = 1	
	THEN
		CALL VIEJO
	END

	# We talked to the viejo and selected 2 (GO)
	IF %DIALOG_RES = 2
	THEN
		' warp to next level
		' decide which is the next level
		' and return it in %JUMP_TO
		CALL NEXT_LEVEL_DO
	END

	# Next level 1st screen
	IF %JUMP_TO > 0
	THEN
		WARP_TO %JUMP_TO, 1, 1
		%NEW_LEVEL = 1
		%FLAG_VIEJO = 0
	END
END
