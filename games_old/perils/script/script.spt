ROOMS = 24
ITEM SLOT = 0
ALIAS %CARRYING = 0

ENTERING GAME
	IF TRUE
	THEN
		# Initalize "carrying", 1 = knickers, 2 = bra
		%CARRYING = 0

		# Also bra & knickers not taken
		%BRA = 0
		%KNICKERS = 0

		# Viehos
		%VIEHO1 = 0
		%VIEHO2 = 0
	END
END

# Screen 0 has a vieho and the bra
# The bra should have beh 128.

ENTERING SCREEN 0
	IF %BRA = 0
	THEN
		SET TILE (7, 1) = 18
	END

	IF %VIEHO1 = 0
	THEN
		SET TILE (7, 5) = 15
		SET TILE (6, 4) = 22
	END
END

# Interact with vieho

PRESS FIRE AT SCREEN 0
	IF PLAYER TOUCHES (6,5)
	IF %VIEHO1 = 0
	IF %CARRYING = 1
	THEN 
		%CARRYING = 0
		%VIEHO1 = 1
		SET TILE (7, 5) = 0
		SET TILE (6, 4) = 0
		SOUND 6
	END 
END 

# Exit ?

ENTERING SCREEN 20
	IF TRUE 
	THEN
		SET TILE (1, 8) = 17	# Draw door
	END

	IF KILLED = 60 				# Remove blockade
	THEN
		SET TILE (2, 7) = 0
		SET TILE (2, 8) = 0
	END 
END

# Screen 22 also has a vieho

ENTERING SCREEN 22
	IF %VIEHO2 = 1
	THEN 
		SET TILE (3, 8) = 0
	END

	IF %VIEHO2 = 0
	THEN
		SET TILE (3, 8) = 15
		SET TILE (2, 7) = 21
	END
END

# Interact with vieho

PRESS FIRE AT SCREEN 22
	IF PLAYER TOUCHES (2,8)
	IF %VIEHO2 = 0
	IF %CARRYING = 2
	THEN 
		%CARRYING = 0
		%VIEHO2 = 1		
		SET TILE (2, 7) = 0
		SET TILE (3, 8) = 0
		SOUND 6
	END 
END 

# Special tiles

SPECIAL TILE TOUCHED
	# There's a special tile in screen 20.
	# Touching it should WIN the game.
	# Otherwise it's an object.

	IF NPANT = 20	
	THEN
		WIN GAME
	END

	# Win game BREAKs, so it's safe to just

	IF TN = 18
	THEN
		GET ITEM SET %BRA
	END

	IF TN = 22
	THEN
		GET ITEM SET %KNICKERS
	END
END

# If last enemy is killed while on screen 20, show

PLAYER KILLS ENEMY
	IF NPANT = 20
	IF KILLED = 1
	THEN 
		SET TILE (2, 7) = 0
		SET TILE (2, 8) = 0
	END 
END
