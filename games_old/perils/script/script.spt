ROOMS = 24

ENTERING GAME
	IF TRUE
	THEN
		KILLED = 0
	END 
END

ENTERING SCREEN 20
	IF TRUE 
	THEN
		SET TILE (1, 8) = 17	# Draw door
	END

	IF ENEMS_KILLED = 60 		# Remove blockade
	THEN
		SET TILE (2, 7) = 0
		SET TILE (2, 8) = 0
	END 
END

PRESS FIRE AT SCREEN 20
	IF PLAYER AT 1, 8
	THEN
		WIN GAME
	END
END 

PLAYER KILLS ENEMY
	IF NPANT = 20
	IF KILLED = 60
	THEN 
		SET TILE (2, 7) = 0
		SET TILE (2, 8) = 0
	END 
END
