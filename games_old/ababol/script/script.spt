# Script Abadol!

# Main shit
ROOMS = 60
ITEM SLOT = 0
ITEM EMPTY = 47

# Explicitly set %CARRYING to ITEM SLOT (FLAG 0).
ALIAS %CARRYING = 0
ALIAS %CANKILL = 31

# For text boxes
TEXT WIDTH = 22

# Boots and medallions should have bit 7 raised in behs

ENTERING GAME
	IF TRUE 
	THEN
		# Init inventory
		%CARRYING = EMPTY

		# Close special gates
		%GATE1 = 0
		%GATE2 = 0
		%GATE3 = 0
		%GATE4 = 0
		%GATE5 = 0

		# Medallions not taken
		%MEDA1 = 0
		%MEDA2 = 0
		%MEDA3 = 0
		%MEDA4 = 0
		%MEDA5 = 0

		# Enemies can't be killed
		%CANKILL = 8

		## Debug ##
		#NPANT = 39
		#PX = 12
		#PY = 5
	END
END

ENTERING ANY
	# Reset coordinates of special shit
	IF TRUE
	THEN
		%MX = 0
		%MY = 0
		%GX = 0
		%GY = 0
		# This coordinate is where "touching gate" is detected. 
		%DGX = 0 
		%K = 0
		%G = 0
	END

	# If getting to row 2 from row 3...
	IF NPANT < 40
	IF OPANT > 39
	# "OPANT" is 0xff when starting a new game so this is needed:
	IF OPANT < 60
	THEN
		# This calls C code to give some 
		# vertical boost when getting out
		# of the water.
		EXTERN 0 0
	END

	# Luna
	IF NPANT < 20
	IF TILE AT (11, 2) = 0
	THEN
		SET TILE (11, 2) = 35
	END
END

# Help boxes

ENTERING SCREEN 0, 2, 20
	IF NPANT = 0
	THEN
		SET TILE (5, 8) = 46
	END

	IF NPANT = 2
	THEN
		SET TILE (11, 8) = 46
	END

	IF NPANT = 20
	THEN
		SET TILE (10, 8) = 46
	END
END

# Draw medallions
# Note how we use & to know the actual flag #

ENTERING SCREEN 3
	IF %MEDA1 = 0
	THEN
		SET TILE (9, 1) = 46
		SET TILE (8, 1) = 37
		%MX = 8
		%MY = 1
		%K = 37
		%G = &%MEDA1
	END
END

ENTERING SCREEN 14
	IF %MEDA2 = 0
	THEN
		SET TILE (3, 8) = 38
		%MX = 3
		%MY = 8
		%K = 38
		%G = &%MEDA2
	END
END

ENTERING SCREEN 29
	IF %MEDA3 = 0
	THEN
		SET TILE (13, 5) = 39
		%MX = 13
		%MY = 5
		%K = 39
		%G = &%MEDA3
	END
END

ENTERING SCREEN 28
	IF %MEDA4 = 0
	THEN
		SET TILE (3, 8) = 40
		%MX = 3
		%MY = 8
		%K = 40
		%G = &%MEDA4
	END
END

# Draw gates
# Note how we use & to know the actual flag #

ENTERING SCREEN 22
	IF %GATE1 = 0
	THEN
		SET TILE (13, 8) = 42
		%GX = 13
		%DGX = 14
		%GY = 8
		%K = 37
		%G = &%GATE1
	END
END 

ENTERING SCREEN 31
	IF %GATE2 = 0
	THEN
		SET TILE (11, 1) = 43
		%GX = 11
		%DGX = 12
		%GY = 1
		%K = 38
		%G = &%GATE2
	END
END 

ENTERING SCREEN 15
	IF %GATE3 = 0
	THEN
		SET TILE (7, 8) = 44
		%GX = 7
		%DGX = 6
		%GY = 8
		%K = 39
		%G = &%GATE3
	END
END 

ENTERING SCREEN 19
	IF %GATE4 = 0
	THEN
		SET TILE (3, 7) = 45
		%GX = 3
		%DGX = 4
		%GY = 7
		%K = 40
		%G = &%GATE4
	END
END 

# Open gates
# This is automated. 
# - If %GX != 0 there's a gate in this screen.
# - If you are touching the gate and carrying %K, you open the gate.
# Gate is FLAG %G or $%G

# Get medallions
# Works the same way

PRESS FIRE AT ANY
	# Even thought the actual gate is a (%GX, %GY),
	# The pos of the player should be (%DGX, %DGY)
	IF %DGX <> 0
	IF PLAYER TOUCHES (%DGX, %GY)
	IF %CARRYING = %K
	THEN
		# Clear inventory 
		%CARRYING = EMPTY

		# Delete tile
		SET TILE (%GX, %GY), 0

		# Set the right GATE flag.
		$%G = 1

		SOUND 2
	END
END

# Boots

ENTERING SCREEN 39
	IF %CANKILL = 8
	THEN
		SET TILE (13, 5) = 36
	END
END

# Get items

SPECIAL TILE TOUCHED
	IF NPANT = 0
	THEN
		TEXT BOX "25 ABABOLES SE OCULTAN EN LOS RECOVECOS DEL DESIERTO DE LOS MONEGROS. ENCUENTRALOS TODOS Y RECUPERA TU ESPADA!"
		SET TILE (5, 8) = 0
		BREAK
	END

	IF NPANT = 2
	THEN
		TEXT BOX "PARA ABRIR CANCELAS NECESITAS LLAVES. ESTAN UN POCO OXIDADAS, TIENES QUE EMPUJARLAS MIENTRAS PULSAS 'FIRE'."
		SET TILE (11, 8) = 0
		BREAK
	END

	IF NPANT = 3
	THEN
		TEXT BOX "ESTOS MEDALLONES ABREN LAS CRIPTAS, PERO SOLO PUEDO LLEVAR UNO CADA VEZ. PUEDO USARLOS PULSANDO 'FIRE' JUNTO A LA PUERTA CORRECTA."
		SET TILE (9, 1) = 0
		BREAK
	END

	IF NPANT = 20
	THEN
		TEXT BOX "DICEN QUE EL RIO SUBTERRANEO CONECTA ZONAS DE LAS CATACUMBAS. ES PELIGROSO PERO NO HAY OTRA FORMA DE LLEGAR A ALGUNOS RECOVECOS."
		SET TILE (10, 8) = 0
		BREAK
	END

	IF NPANT = 39
	IF %CANKILL = 8
	THEN
		%CANKILL = 0
		SET TILE (13, 5) = 0
		SOUND 8
		TEXT BOX "OJETE CUIDAO! CON ESTAS BOTAZAS DE CUERO TENGO EL PODER DE MATAR PISANDO CABEZAS!"
		BREAK
	END

	IF %MX <> 0
	IF PLAYER TOUCHES (%MX, %MY)
	IF %CARRYING = EMPTY
	THEN
		GET ITEM SET $%G
		SOUND 8
	END
END
