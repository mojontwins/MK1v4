NOINDEXED 		# We won't be using SCREEN XXX sections
FASTNPANT 		# IF NPANT = N will generate its own opcode/interpreter

ENTERING GAME
	IF TRUE
	THEN
		TEXT BOX "PRUEBA DE TEXT BOX! BIENVENIDO A PUMBY CARAVERGA, AVENTURERO!"
	END
END

ENTERING ANY
	# Paint the moon
	IF TILE AT (8, 1) = 0
	THEN
		# Tile 49 is out of bounds and abuses how the engine work.
		# It ends up printed with patters from font.png.
		SET TILE (8, 1) = 49
	END

	# Turn on fanty generation
	IF TRUE
	THEN
		DONT_MAKE_FANTIES = 0
	END
END

PLAYER GOT SOMETHING
	IF HOTSPOT = 1
	IF OBJS = 24
	THEN
		WIN GAME
	END

	# Incredible engine abuse to paint a hotspot using the font
	IF HOTSPOT = 34
	THEN 
		DONT_MAKE_FANTIES = 1

		# This will kill all enemies, inc. fanties
		EXTERN 0, 0
	END
END

SPECIAL TILE TOUCHED
	IF NPANT = 3 
	THEN
		SOUND 8
		DECOS
			10, 2, 3
			10, 3, 0
			10, 4, 0
			10, 5, 0
			10, 6, 0
			10, 7, 0
			10, 8, 12
			12, 7, 0
		END
	END

	IF NPANT = 5
	THEN
		SOUND 8
		DECOS
			7, 1, 13
			7, 7, 0
			8, 9, 0
			9, 7, 0
		END
	END

	IF NPANT = 10
	THEN
		SOUND 8
		DECOS
			3, 5, 0
			13, 4, 0
			13, 5, 0
		END
	END

	IF NPANT = 14
	THEN
		SOUND 8
		DECOS
			12, 4, 13
			0, 5, 13
		END
	END

	IF NPANT = 44
	THEN
		SOUND 8
		DECOS
			3, 5, 0
			11, 0, 0
			11, 1, 0
			11, 2, 0
			11, 3, 13
		END
	END
END 
